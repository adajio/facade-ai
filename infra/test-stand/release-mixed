#!/usr/bin/env bash
set -euo pipefail
umask 077

here="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd -- "$here/../.." && pwd)"
scenario="$root/test/acceptance/release-mixed"
context="${FACADE_RELEASE_DOCKER_CONTEXT:-orbstack}"
project="facade-release-$(openssl rand -hex 8)"
if [[ "${FACADE_DWG_ENGINE:-oda}" != oda ]]; then
  echo 'Remove the obsolete FACADE_DWG_ENGINE setting. DWG uses ODA.' >&2
  exit 2
fi
: "${FACADE_ODA_ROOT:?Specify the pinned ODA installation}" "${FACADE_ODA_RUNTIME:?Specify the pinned ODA runtime}"
: "${FACADE_ODA_BINARY_SHA256:?Specify the ODA binary SHA-256}"
out_root="$(cd -- "${FACADE_RELEASE_DIR:?Set a private results directory outside the checkout}" && pwd -P)"
case "$out_root/" in "$root/"*) echo 'Use a results directory outside the checkout.' >&2; exit 2 ;; esac
out="$(mktemp -d "$out_root/$project.XXXXXXXX")"
printf 'Release rehearsal evidence: %s\n' "$out"

docker() { command docker --context "$context" "$@"; }
compose_files=(--file "$here/compose.yaml" --file "$here/compose.app.yaml" --file "$here/compose.broker.yaml"
  --file "$here/compose.worker-broker.yaml")
if [[ -n "${FACADE_RELEASE_SUBNET:-}" ]]; then
  [[ "$FACADE_RELEASE_SUBNET" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}/[0-9]{1,2}$ ]] || {
    echo 'FACADE_RELEASE_SUBNET must be an unused private IPv4 CIDR.' >&2; exit 2;
  }
  printf 'networks:\n  default:\n    ipam:\n      config:\n        - subnet: %s\n' "$FACADE_RELEASE_SUBNET" > "$out/subnet.yaml"
  compose_files+=(--file "$out/subnet.yaml")
fi
compose() {
  docker compose --project-name "$project" "${compose_files[@]}" "$@"
}
image_id() {
  docker image inspect --format '{{.Id}}' -- "$1"
}
wait_file() {
  for ((attempt=0; attempt<60; attempt++)); do
    if [[ -s "$1" ]]; then return; fi
    sleep 0.25
  done
  echo "Missing startup evidence: $1" >&2
  exit 1
}

reader_image="$(image_id "${FACADE_RELEASE_READER_IMAGE:?Specify the candidate reader image}")"
broker_image="$(image_id "${FACADE_RELEASE_BROKER_IMAGE:?Specify the candidate broker image}")"
office_image="$(image_id "${FACADE_RELEASE_OFFICE_IMAGE:?Specify the LibreOffice image}")"
dwg_image="$(image_id "${FACADE_RELEASE_DWG_IMAGE:?Specify the ODA launcher image}")"

# The candidate runs without model keys, external gateway profile, or Internet access.
export FACADE_STAND_IMAGE="$reader_image" FACADE_STAND_BROKER_IMAGE="$broker_image"
export FACADE_OFFICE_IMAGE="$office_image" FACADE_DWG_IMAGE="$dwg_image" FACADE_ARCHIVE_IMAGE=''
export FACADE_STAND_DIR="$out" FACADE_STAND_RUN="$out" FACADE_STAND_UID="$(id -u)" FACADE_STAND_GID="$(id -g)"
export FACADE_STAND_NETWORK="${project}_private" FACADE_STAND_SOCKET_NAME="$project.sock"
export FACADE_STAND_SOCKET_VOLUME="${project}_socket" FACADE_STAND_SCRATCH_VOLUME="${project}_scratch"
export FACADE_STAND_ORIGIN=''
mkdir "$out"/{secrets,objects,tmp,state,producer}
cp "$root"/infra/local-terra/*.mjs "$out/producer/"
cp "$scenario/adapter.py" "$out/producer/adapter.py"
stage=image_profile
relay_pid=''
volumes_ready=''
stack_ready=''
cleanup() {
  status=$?
  trap - EXIT
  if [[ "$status" -ne 0 ]]; then printf 'FAIL %s (%s)\n' "$stage" "$status" >&2; fi
  if [[ -n "$relay_pid" ]]; then kill "$relay_pid" 2>/dev/null || true; fi
  if [[ -n "$stack_ready" ]]; then
    compose logs --no-color --tail=250 api worker converter-broker > "$out/containers.log" 2>&1 || true
    docker logs --tail=100 "$project-producer" > "$out/producer.log" 2>&1 || true
    compose down --volumes --remove-orphans >> "$out/cleanup.log" 2>&1 || status=1
  fi
  if [[ -n "$volumes_ready" ]]; then
    docker volume rm "$FACADE_STAND_SCRATCH_VOLUME" "$FACADE_STAND_SOCKET_VOLUME" >> "$out/cleanup.log" 2>&1 || status=1
  fi
  rm -f "$out/runtime.env" "$out/password" "$out/secrets/postgres-password" "$out/secrets/garage.toml"
  rm -rf "$out/signing"
  if [[ "$status" -eq 0 ]]; then
    printf '%s\n' 'PASS mixed package and persisted review after restart'
  fi
  exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

docker run --rm --pull never --network none --entrypoint /bin/sh "$reader_image" -ec \
  'pdftotext -v; tesseract --version; tesseract --list-langs; python3 --version' > "$out/reader-tools.txt" 2>&1
docker image inspect --format '{{.Id}} {{.Os}}/{{.Architecture}} {{with index .Config "Labels"}}{{index . "org.opencontainers.image.revision"}} {{index . "io.facade.source-manifest-sha256"}}{{end}}' -- \
  "$reader_image" "$broker_image" "$office_image" "$dwg_image" > "$out/images.txt"
printf 'oda\n' > "$out/dwg-engine.txt"
(
  cd "$root"
  git rev-parse HEAD
  shasum -a 256 test/acceptance/release-mixed/* infra/catalogs/intake-stage-1.json \
    infra/test-stand/{release-mixed,relay.mjs,compose.yaml,compose.app.yaml,compose.broker.yaml,compose.worker-broker.yaml}
  cd "$out"
  shasum -a 256 producer/*
) > "$out/scenario-sources.txt"

stage=storage
openssl rand -hex 32 > "$out/secrets/postgres-password"
openssl rand -hex 24 > "$out/password"
db_password="$(openssl rand -hex 24)"
access="GK$(openssl rand -hex 12)"
secret="$(openssl rand -hex 32)"
cat > "$out/secrets/garage.toml" <<TOML
metadata_dir = "/var/lib/garage/meta"
data_dir = "/var/lib/garage/data"
db_engine = "sqlite"
replication_factor = 1
rpc_bind_addr = "127.0.0.1:3901"
rpc_public_addr = "127.0.0.1:3901"
rpc_secret = "$(openssl rand -hex 32)"
[s3_api]
s3_region = "us-east-1"
api_bind_addr = "0.0.0.0:3900"
TOML
cat > "$out/runtime.env" <<ENV
DATABASE_URL=postgresql://rehearsal:$db_password@postgres:5432/rehearsal
FACADE_S3_ENDPOINT=http://objects:3900
FACADE_S3_BUCKET=release-mixed
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=$access
AWS_SECRET_ACCESS_KEY=$secret
ENV
docker volume create "$FACADE_STAND_SCRATCH_VOLUME" >/dev/null
volumes_ready=1
docker volume create "$FACADE_STAND_SOCKET_VOLUME" >/dev/null
FACADE_STAND_BROKER_SCRATCH="$(docker volume inspect --format '{{.Mountpoint}}' "$FACADE_STAND_SCRATCH_VOLUME")"
export FACADE_STAND_BROKER_SCRATCH
stack_ready=1
compose up -d --wait --pull never postgres objects relay converter-broker > "$out/start.log" 2>&1
[[ "$(docker network inspect --format '{{.Internal}}' "$FACADE_STAND_NETWORK")" == true ]]
compose exec -T converter-broker node -e '
  const assert = require("node:assert/strict");
  require("node:http").get({ socketPath: process.env.FACADE_CONVERTER_SOCKET, path: "/v1/info" }, response => {
    response.setEncoding("utf8");
    let body = "";
    response.on("data", chunk => { body += chunk; });
    response.on("end", () => {
      const profile = JSON.parse(body);
      assert.equal(response.statusCode, 200);
      assert.equal(profile.doc, process.env.FACADE_OFFICE_IMAGE);
      assert.equal(profile.dwg, process.env.FACADE_DWG_IMAGE);
      assert.equal(profile.dwgEngine, "oda");
      assert.match(profile.dwgIdentity, /^sha256:[0-9a-f]{64}$/);
      console.log(JSON.stringify(profile));
    });
  });
' > "$out/converter-profile.json"
compose exec -T --user postgres postgres psql -X -q -v ON_ERROR_STOP=1 -U postgres -d postgres <<SQL
SET log_min_error_statement = 'panic';
CREATE ROLE rehearsal LOGIN PASSWORD '$db_password' NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION;
CREATE DATABASE rehearsal OWNER rehearsal;
SQL
compose exec -T objects /garage bucket create release-mixed >> "$out/start.log" 2>&1
compose exec -T objects /garage key import --yes -n rehearsal "$access" "$secret" >/dev/null 2>&1
compose exec -T objects /garage bucket allow --read --write release-mixed --key "$access" >/dev/null 2>&1
node "$here/relay.mjs" host-api "$(command -v docker)" "${project}-relay-1" "$context" > "$out/origin" 2> "$out/relay.log" &
relay_pid=$!
wait_file "$out/origin"
export FACADE_STAND_ORIGIN="$(cat "$out/origin")"
export FACADE_RELEASE_ORIGIN="$FACADE_STAND_ORIGIN"
export FACADE_RELEASE_RUN="$out"

stage=bootstrap
compose run --rm --no-deps -T api dist/src/platform/migrate.js > "$out/migration.log" 2>&1
compose run --rm --no-deps -T api dist/src/modules/access/bootstrap.js 'Synthetic release rehearsal' pkgintake_release \
  < "$out/password" > "$out/bootstrap.log" 2>&1
compose up -d --wait --no-deps api worker >> "$out/start.log" 2>&1

start_producer() {
  compose run -d --no-deps --name "$project-producer" \
    --volume "$out/producer:/preliminary/producer:ro" --volume "$out/state:/preliminary/state" \
    -e FACADE_PRELIMINARY_BASE=/preliminary -e FACADE_SOURCE_ROOT=/app \
    -e FACADE_PRELIMINARY_PUBLISHER=/app/dist/src/modules/assessment/preliminary-package-review.js \
    -e FACADE_CODEX_ADAPTER=/preliminary/producer/adapter.py api /preliminary/producer/producer.mjs >> "$out/start.log" 2>&1
}

check_saved_objects() {
  compose run --rm --no-deps -T \
    --volume "$scenario/saved.mjs:/rehearsal/saved.mjs:ro" --volume "$out/upload.json:/rehearsal/upload.json:ro" \
    api /rehearsal/saved.mjs > "$out/saved-$1.json"
}

stage=initial_review
start_producer
node "$scenario/check.mjs" initial
check_saved_objects initial

stage=restart
# Recreate processes. In the second phase the converter, worker and producer are all stopped.
compose stop worker api converter-broker >> "$out/start.log" 2>&1
docker stop "$project-producer" >> "$out/start.log" 2>&1
compose up -d --wait --force-recreate --no-deps api >> "$out/start.log" 2>&1
stage=read_after_restart
node "$scenario/check.mjs" restarted
check_saved_objects restarted
cmp "$out/saved-initial.json" "$out/saved-restarted.json"
