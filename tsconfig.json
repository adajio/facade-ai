{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "rewriteRelativeImportExtensions": true,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "types": ["node"],
    "sourceMap": true
  },
  "include": ["apps/**/*.ts", "src/**/*.ts", "test/**/*.ts"]
}
