{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research intent and application disposition",
  "description": "Каноническая запись приложения после обработки адресной инициативы. Права и квитанции привязаны к авторизованному запуску.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "intentId", "workId", "inputRevision", "policyRevision", "obligationId", "scopeTarget", "trigger", "target", "reason", "disposition"],
  "properties": {
    "schemaVersion": {"const": 1},
    "intentId": {"$ref": "#/$defs/id"},
    "workId": {"$ref": "#/$defs/id"},
    "inputRevision": {"$ref": "#/$defs/id"},
    "policyRevision": {"$ref": "#/$defs/id"},
    "obligationId": {"$ref": "#/$defs/id"},
    "scopeTarget": {"oneOf": [
      {"type": "object", "additionalProperties": false, "properties": {"kind": {"const": "unresolved"}}, "required": ["kind"]},
      {"type": "object", "additionalProperties": false, "properties": {"kind": {"const": "accepted"}, "scopeId": {"$ref": "#/$defs/id"}}, "required": ["kind", "scopeId"]}
    ]},
    "trigger": {"type": "object", "additionalProperties": false, "required": ["kind", "id"], "properties": {"kind": {"enum": ["unit", "locator", "limitation", "obligation"]}, "id": {"$ref": "#/$defs/id"}}},
    "target": {"type": "object", "additionalProperties": false, "required": ["unitIds", "methodProfileId"], "properties": {
      "unitIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
      "range": {"$ref": "#/$defs/id", "description": "Ссылка на канонический диапазон или область оглавления в закреплённом оригинале."},
      "methodProfileId": {"$ref": "#/$defs/id"}
    }},
    "reason": {"$ref": "#/$defs/id"},
    "disposition": {
      "type": "object", "additionalProperties": false, "required": ["status", "reasonCode"],
      "properties": {"status": {"enum": ["accepted", "reused", "deferred", "rejected"]}, "workId": {"$ref": "#/$defs/id"}, "reasonCode": {"$ref": "#/$defs/id"}, "resumeCondition": {"$ref": "#/$defs/id"}},
      "allOf": [
        {"if": {"properties": {"status": {"enum": ["accepted", "reused"]}}}, "then": {"required": ["workId"]}, "else": {"not": {"required": ["workId"]}}},
        {"if": {"properties": {"status": {"const": "deferred"}}}, "then": {"required": ["resumeCondition"]}, "else": {"not": {"required": ["resumeCondition"]}}}
      ]
    }
  },
  "$defs": {"id": {"type": "string", "minLength": 1}}
}
